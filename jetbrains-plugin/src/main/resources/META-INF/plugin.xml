<idea-plugin>
    <id>com.doge.code</id>
    <name>Doge Code</name>
    <vendor email="support@doge-code.com" url="https://github.com/kaixings1/doge-code">Doge Code</vendor>

    <description><![CDATA[
      Doge Code - AI 编程助手插件
      <br><br>
      功能：
      <ul>
        <li>AI 聊天助手</li>
        <li>代码补全</li>
        <li>用量统计</li>
        <li>多模型切换</li>
      </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 工具窗口 -->
        <toolWindow id="Doge Code" secondary="true" anchor="right" factoryClass="com.doge.code.DogeCodeToolWindowFactory"/>
        <!-- 配置面板 -->
        <applicationConfigurable parentId="tools" instance="com.doge.code.DogeCodeConfigurable" id="com.doge.code.Settings" displayName="Doge Code"/>
        <!-- 应用级别服务 -->
        <applicationService serviceImplementation="com.doge.code.DogeCodeService"/>
    </extensions>

    <actions>
        <action id="com.doge.code.OpenChat" class="com.doge.code.OpenChatAction" text="打开 Doge Code 聊天" description="打开 Doge Code 聊天窗口">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
