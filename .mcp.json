{
  "mcpServers": {
    "win-autoui": {
      "command": "D:/Python312/python.exe",
      "args": [
        "D:/MFC_TESTER/main.py"
      ]
    },
    "pywinauto-mcp": {
      "command": "uv",
      "args": [
        "run",
        "--python",
        "D:/Python312/python.exe",
        "--directory",
        "D:/MFC_TESTER/mcp_servers_downloaded/pywinauto-mcp-main",
        "python",
        "server.py",
        "--transport",
        "stdio"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:/"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "git": {
      "command": "uv",
      "args": [
        "run",
        "--python",
        "D:/Python312/python.exe",
        "--directory",
        "D:/MFC_TESTER/mcp_servers_downloaded/mcp-everything/src/git",
        "mcp-server-git"
      ]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "D:/doge-code/vendor/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant"
      ],
      "env": {
        "PYTHONHOME": "",
        "PYTHONPATH": ""
      }
    },
    "rea": {
      "command": "npx",
      "args": ["-y", "rea-agents@6.4.0", "mcp"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.4.1"]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking@1.0.0"]
    }
  }
}