{
  "mcpServers": {
    "win-autoui": {
      "command": "python",
      "args": ["main.py"],
      "cwd": "D:/MFC_TESTER"
    },
    "pywinauto-mcp": {
      "command": "uv",
      "args": ["run", "--directory", "D:/MFC_TESTER/mcp_servers_downloaded/pywinauto-mcp-main", "python", "server.py", "--transport", "stdio"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "D:/"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "git": {
      "command": "uv",
      "args": ["--directory", "D:/MFC_TESTER/mcp_servers_downloaded/mcp-everything/src/git", "run", "mcp-server-git", "--repository", "D:/MFC_TESTER"]
    }
  }
}
