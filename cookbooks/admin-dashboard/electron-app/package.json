{
  "name": "admin-panel",
  "version": "1.0.0",
  "description": "后台管理系统",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.admin.panel",
    "productName": "后台管理系统",
    "directories": {
      "output": "../dist"
    },
    "win": {
      "target": "portable",
      "icon": null
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
