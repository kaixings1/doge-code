# 核心代码：内存管理器
cat << 'EOF' > src/core/MemoryManager.ts
export interface MemoryThresholds {
  highWaterMark: number; // MB
  criticalWaterMark: number; // MB
  checkInterval: number; // ms
}

export class MemoryManager {
  private thresholds: MemoryThresholds;
  private lastGC: number = 0;
  private gcInterval: number = 30000; // 30s

  constructor(thresholds: Partial<MemoryThresholds> = {}) {
    this.thresholds = {
      highWaterMark: thresholds.highWaterMark ?? 1024, // 1GB
      criticalWaterMark: thresholds.criticalWaterMark ?? 2048, // 2GB
      checkInterval: thresholds.checkInterval ?? 5000, // 5s
    };
  }

  getUsageMB(): number {
    if (typeof process !== 'undefined' && process.memoryUsage) {
      return process.memoryUsage().heapUsed / 1024 / 1024;
    }
    return 0;
  }

  isCritical(): boolean {
    return this.getUsageMB() > this.thresholds.criticalWaterMark;
  }

  isHigh(): boolean {
    return this.getUsageMB() > this.thresholds.highWaterMark;
  }

  tryGC(): boolean {
    const now = Date.now();
    if (now - this.lastGC < this.gcInterval) return false;

    if (typeof global.gc === 'function') {
      global.gc();
      this.lastGC = now;
      return true;
    }
    return false;
  }

  async waitForMemory(): Promise<void> {
    const sleep = (ms: number) => new Promise(r => setTimeout(r, ms));
    while (this.isCritical()) {
      this.tryGC();
      await sleep(this.thresholds.checkInterval);
    }
  }

  getStatus() {
    return {
      usedMB: Math.round(this.getUsageMB()),
      highWaterMark: this.thresholds.highWaterMark,
      criticalWaterMark: this.thresholds.criticalWaterMark,
      isHigh: this.isHigh(),
      isCritical: this.isCritical(),
    };
  }
}
