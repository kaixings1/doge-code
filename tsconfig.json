{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "types": [
      "bun"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*",
    "vendor/**/*",
    "shims/**/*",
    "src/generated/**/*"
  ],
  "exclude": [
    "src/**/*.mjs",
    "src/desktop-electron/renderer/components/MonacoEditorPanel.tsx",
    ".tools/**/*"
  ]
}
