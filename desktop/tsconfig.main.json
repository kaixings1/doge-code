{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist/main",
    "sourceMap": false,
    "declaration": false,
    "noEmitOnError": false,
    "noImplicitAny": false,
    "strict": false,
    "removeComments": false,
    "preserveConstEnums": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/main/**/*",
    "src/utils/**/*",
    "../../src/**/*"
  ],
  "exclude": ["node_modules", "dist", "../../node_modules"]
}
