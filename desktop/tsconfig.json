{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "./dist",
    "rootDir": "src"
  },
  "include": [
    "src/renderer/**/*",
    "src/preload/**/*",
    "src/desktop/**/*",
    "src/renderer/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}