{
  "name": "@doge-code/cli",
  "version": "999.0.0-DOGE",
  "private": true,
  "description": "Restored Claude Code source tree reconstructed from source maps.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "packageManager": "bun@1.3.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/anthropics/claude-code.git"
  },
  "engines": {
    "bun": ">=1.3.5",
    "node": ">=24.0.0"
  },
  "scripts": {
    "prebuild": "bun run scripts/embed-status-line.ts",
    "build": "bun build ./src/entrypoints/cli.tsx --compile --outfile ./doge && bun run scripts/postbuild-tools.ts",
    "dev": "bun run ./src/bootstrap-entry.ts",
    "start": "bun run ./src/bootstrap-entry.ts",
    "version": "bun run ./src/bootstrap-entry.ts --version",
    "dev:restore-check": "bun run ./src/dev-entry.ts",
    "dev:desktop": "bun run ./src/bootstrap-entry.ts --desktop",
    "build:desktop": "bun run prebuild && node src/desktop-electron/build-vite.cjs && cd desktop && electron-builder -c.npmRebuild=false -c.asarUnpack=\"**/node_modules/{@electron,electron-updater}/**\" -c.asarUnpack=\"**/node_modules/node-pty/**\"",
    "lint": "biome check src/",
    "lint:fix": "biome check --apply src/",
    "format": "biome format --write src/",
    "knip": "knip"
  },
  "compilerOptions": {
    "compiler": {
      "reactCompiler": false
    }
  },
  "bin": {
    "doge": "./src/bootstrap-entry.ts"
  },
  "dependencies": {
