an> </a> <a href="/donate-list" class="p-3 rounded-xl bg-slate-800 border border-slate-700/70 text-xs text-slate-200 hover:bg-slate-700/80 flex items-center gap-2 transition-colors"> <span class="text-amber-400">🏆</span> <span>致谢名单</span> </a> </div> </div> </div> </nav> <script>
  // Theme Toggle with Follow-System Support
  const themeBtn = document.getElementById('themeToggleBtn');
  const isEn = document.documentElement.lang === 'en';

  const updateThemeTitle = (themeState) => {
    if (!themeBtn) return;
    if (themeState === 'system') {
      themeBtn.setAttribute('title', isEn ? 'Theme: Follow System (Click to toggle)' : '主题模式：跟随系统（点击切换）');
    } else if (themeState === 'light') {
      themeBtn.setAttribute('title', isEn ? 'Theme: Light (Click to toggle)' : '主题模式：浅色模式（点击切换）');
    } else if (themeState === 'dark') {
      themeBtn.setAttribute('title', isEn ? 'Theme: Dark (Click to toggle)' : '主题模式：深色模式（点击切换）');
    }
  };

  const storedTheme = localStorage.getItem('ghproxy_theme');
  updateThemeTitle(storedTheme || 'system');

  // Listen for system theme changes when in follow-system mode
  try {
    const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
    const handleSystemChange = (e) => {
      const stored = localStorage.getItem('ghproxy_theme');
      if (!stored || stored === 'system') {
        if (e.matches) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }
    };
    if (mediaQuery.addEventListener) {
      mediaQuery.addEventListener('change', handleSystemChange);
    } else if (mediaQuery.addListener) {
      mediaQuery.addListener(handleSystemChange);
    }
  } catch (e) {}

  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const currentStored = localStorage.getItem('ghproxy_theme');
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      
      let nextTheme;
      if (!currentStored || currentStored === 'system') {
        nextTheme = systemDark ? 'light' : 'dark';
      } else if (currentStored === 'light') {
        nextTheme = systemDark ? 'system' : 'dark';
      } else { // 'dark'
        nextTheme = systemDark ? 'light' : 'system';
      }

      if (nextTheme === 'system') {
        localStorage.removeItem('ghproxy_theme');
        if (systemDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        updateThemeTitle('system');
        if (window.showToast) {
          window.showToast(isEn ? 'Theme: Follow System' : '主题已恢复为：跟随系统模式');
        }
      } else if (nextTheme === 'light') {
        localStorage.setItem('ghproxy_theme', 'light');
        document.documentElement.classList.remove('dark');
        updateThemeTitle('light');
        if (window.showToast) {
          window.showToast(isEn ? 'Theme: Light Mode' : '主题已切换为：浅色模式');
        }
      } else { // 'dark'
        localStorage.setItem('ghproxy_theme', 'dark');
        document.documentElement.classList.add('dark');
        updateThemeTitle('dark');
        if (window.showToast) {
          window.showToast(isEn ? 'Theme: Dark Mode' : '主题已切换为：深色模式');
        }
      }
    });
  }

  // Mobile Menu Drawer Handler
  const mobileToggle = document.getElementById('mobileMenuToggle');
  const mobileDrawer = document.getElementById('mobileDrawer');
  const hamburgerIcon = document.getElementById('hamburgerIcon');
  const closeIcon = document.getElementById('closeIcon');

  function openMobileMenu() {
    if (!mobileDrawer) return;
    mobileDrawer.classList.remove('hidden');
    if (hamburgerIcon) {
      hamburgerIcon.classList.add('hidden');
      hamburgerIcon.classList.remove('block');
    }
    if (closeIcon) {
      closeIcon.classList.remove('hidden');
      closeIcon.classList.add('block');
    }
    document.body.style.overflow = 'hidden';
  }

  function closeMobileMenu() {
    if (!mobileDrawer) return;
    mobileDrawer.classList.add('hidden');
    if (hamburgerIcon) {
      hamburgerIcon.classList.remove('hidden');
      hamburgerIcon.classList.add('block');
    }
    if (closeIcon) {
      closeIcon.classList.add('hidden');
      closeIcon.classList.remove('block');
    }
    document.body.style.overflow = '';
  }

  function toggleMobileMenu() {
    if (!mobileDrawer) return;
    if (mobileDrawer.classList.contains('hidden')) {
      openMobileMenu();
    } else {
      closeMobileMenu();
    }
  }

  if (mobileToggle) {
    mobileToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMobileMenu();
    });
  }

  // Close mobile drawer when any link is clicked
  if (mobileDrawer) {
    mobileDrawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        closeMobileMenu();
      });
    });
  }
</script>  <!-- Main Content --> <main class="flex-grow">  <script>
    (function() {
      try {
        var path = window.location.pathname;
        var isEn = path.indexOf('/en') === 0;
        var cleanPath = isEn ? path.slice(3) : path;
        var prefix = isEn ? '/en/#' : '/#';

        var match = cleanPath.match(/^\/(?:https?:\/+)?(?:www\.)?github\.com\/(?!(?:features|about|pricing|security|login|join|explore|topics|trending|marketplace|organizations|docs|blog|assets|api|admin|_astro|waline-api)\/)([a-zA-Z0-9_.-]+)\/([a-zA-Z0-9_.-]+?)(?:\.git)?(?:\/releases)?\/?$/i);
        if (match) {
          window.location.replace(prefix + 'https://github.com/' + match[1] + '/' + match[2]);
          return;
        }

        var shortMatch = cleanPath.match(/^\/([a-zA-Z0-9_.-]+)\/([a-zA-Z0-9_.-]+?)(?:\.git)?\/?$/i);
        if (shortMatch) {
          var reserved = ['about', 'privacy', 'terms', 'donate', 'donate-list', 'analytics', 'docker', 'sourceforge', 'opensheet', 'link', 'docs', 'blog', 'admin', 'waline-api', 'api', 'assets', '_astro'];
          if (reserved.indexOf(shortMatch[1].toLowerCase()) === -1) {
            window.location.replace(prefix + 'https://github.com/' + shortMatch[1] + '/' + shortMatch[2]);
            return;
          }
        }
      } catch(e) {}
    })();
  </script> <div class="max-w-xl mx-auto px-4 py-24 sm:py-32 text-center space-y-6"> <div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-emerald-500/10 text-emerald-500 border border-emerald-500/20 text-3xl font-mono font-bold">
