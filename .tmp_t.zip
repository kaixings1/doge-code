> <div class="mt-12 pt-8 border-t border-slate-200/80 dark:border-white/5 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-zinc-500"> <p>© 2026 GH-Proxy. 保留所有权利。由全球开源社区驱动。</p> <p class="text-center md:text-right max-w-xl">本站仅提供中立的开源分发与反向代理网络加速服务，不存储也不拥有任何第三方版权资产。</p> </div> </div> </footer> </div> <!-- Toast helper script --> <script>
      window.showToast = function(message, type = 'success') {
        const container = document.getElementById('toast-container');
        if (!container) return;
        const toast = document.createElement('div');
        toast.className = `px-4 py-2.5 rounded-xl shadow-lg text-sm font-medium transition-all duration-300 transform translate-y-2 opacity-0 pointer-events-auto flex items-center gap-2 border ${
          type === 'success' 
            ? 'bg-emerald-950/90 text-emerald-200 border-emerald-500/30 shadow-emerald-500/10' 
            : type === 'error'
            ? 'bg-red-950/90 text-red-200 border-red-500/30 shadow-red-500/10'
            : 'bg-zinc-900/90 text-zinc-200 border-zinc-700 shadow-black/20'
        }`;
        toast.innerHTML = `
          <svg class="w-4 h-4 flex-shrink-0 ${type === 'success' ? 'text-emerald-400' : type === 'error' ? 'text-red-400' : 'text-zinc-400'}" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            ${type === 'success' 
              ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />' 
              : type === 'error'
              ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />'
              : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />'}
          </svg>
          <span>${message}</span>
        `;
        container.appendChild(toast);
        requestAnimationFrame(() => {
          toast.classList.remove('translate-y-2', 'opacity-0');
        });
        setTimeout(() => {
          toast.classList.add('translate-y-2', 'opacity-0');
          setTimeout(() => toast.remove(), 300);
        }, 2600);
      };
    </script> </body> </html>