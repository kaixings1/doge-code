import type { LocalJSXCommandCall } from '../../types/command.js';
import { readFileSync, existsSync } from 'fs';
import { join } from 'path';

interface PackageInfo {
  name?: string;
  version?: string;
  dependencies?: Record<string, string>;
  devDependencies?: Record<string, string>;
}

class SimpleDependencyAnalyzer {
  analyzePackageJson(projectRoot: string): {
    packageInfo: PackageInfo;
    stats: { total: number; production: number; development: number };
  } {
    const packageJsonPath = join(projectRoot, 'package.json');

    if (!existsSync(packageJsonPath)) {
      return {
        packageInfo: {},
        stats: { total: 0, production: 0, development: 0 }
      };
    }

    try {
      const packageJson = JSON.parse(readFileSync(packageJsonPath, 'utf-8'));
      const deps = packageJson.dependencies || {};
      const devDeps = packageJson.devDependencies || {};

      return {
        packageInfo: packageJson,
        stats: {
          total: Object.keys(deps).length + Object.keys(devDeps).length,
          production: Object.keys(deps).length,
          development: Object.keys(devDeps).length
        }
      };
    } catch (error) {
      console.error('分析package.json失败:', error);
      return {
        packageInfo: {},
        stats: { total: 0, production: 0, development: 0 }
      };
    }
  } findLargeDependencies(packageInfo: PackageInfo): Array<{ name: string; version: string; type: string }> { const largeDeps: Array<{ name: string; version: string; type: string }> = [] // 常见的大型依赖 const knownLargeDeps = [ 'webpack', 'babel', 'typescript', 'react', 'vue', 'angular', 'electron', 'puppeteer', 'selenium', 'jest', 'cypress', 'lodash', 'moment', 'date-fns', 'axios', 'express' ] const checkDeps = (deps: Record<string, string> | undefined, type: string) => { if (!deps) return for (const [name, version] of Object.entries(deps)) { if (knownLargeDeps.includes(name.toLowerCase())) { largeDeps.push({ name, version, type }) } } } checkDeps(packageInfo.dependencies, 'production') checkDeps(packageInfo.devDependencies, 'development') return largeDeps } findPotentialIssues(packageInfo: PackageInfo): string[] { const issues: string[] = [] // 检查过时的依赖版本模式 const checkVersion = (name: string, version: string, type: string) => { if (version.includes('alpha') || version.includes('beta') || version.includes('rc')) { issues.push(`${type}依赖 ${name}@${version} 使用了预发布版本`) } if (version === '*' || version === 'latest') { issues.push(`${type}依赖 ${name}@${version} 使用了不稳定的版本范围`) } if (version.startsWith('^') || version.startsWith('~')) { // 这是正常的版本范围，不报问题 } else if (!version.match(/^/d+/./d+/./d+/)) { issues.push(`${type}依赖 ${name}@${version} 版本格式异常`) } } if (packageInfo.dependencies) { for (const [name, version] of Object.entries(packageInfo.dependencies)) { checkVersion(name, version, '生产') } } if (packageInfo.devDependencies) { for (const [name, version] of Object.entries(packageInfo.devDependencies)) { checkVersion(name, version, '开发') } } // 检查常见的安全问题模式 const securityPatterns = [ { pattern: /jquery/i, issue: '使用jQuery可能存在XSS漏洞' }, { pattern: /lodash/D*4/./d+/./d+/, issue: 'lodash 4.x版本存在原型污染漏洞' }, { pattern: /express/D*4/./d+/./d+/, issue: 'Express 4.x需要配置安全中间件' } ] const allDeps = { ...packageInfo.dependencies, ...packageInfo.devDependencies } for (const [name, version] of Object.entries(allDeps)) { for (const { pattern, issue } of securityPatterns) { if (pattern.test(`${name}@${version}`)) { issues.push(issue) } } } return issues } generateRecommendations(stats: { total: number; production: number; development: number }, issues: string[]): string[] { const recommendations: string[] = [] if (stats.total > 50) { recommendations.push('依赖数量较多，考虑精简或使用monorepo') } if (stats.production > 30) { recommendations.push('生产依赖较多，可能影响打包体积和启动速度') } if (stats.development > 20) { recommendations.push('开发依赖较多，考虑优化开发工具链') } if (issues.length > 5) { recommendations.push('发现多个潜在问题，建议详细检查') } if (recommendations.length === 0) { recommendations.push('依赖结构良好，继续保持') } return recommendations }
} const analyzer = new SimpleDependencyAnalyzer() export const call: LocalJSXCommandCall = async (onDone, context, args) => { const parts = args?.trim().split(//s+/) || [] const command = parts[0]?.toLowerCase() || 'help' const cwd = context?.getAppState?.()?.cwd || process.cwd() const analysis = analyzer.analyzePackageJson(cwd) if (command === 'help' || command === '') { return { type: 'jsx', render: () => [ '📦 依赖分析工具', '', '简单的项目依赖分析工具。', '', '命令:', ' /dependency-analyzer overview - 项目概览', ' /dependency-analyzer stats - 依赖统计', ' /dependency-analyzer large - 大型依赖', ' /dependency-analyzer issues - 潜在问题', ' /dependency-analyzer help - 显示帮助', '', '示例:', ' /dependency-analyzer overview', ' /dependency-analyzer large', '', '分析内容:', ' - 依赖数量统计', ' - 大型依赖识别', ' - 潜在问题检测', ' - 优化建议' ].join('/n') } } if (command === 'overview' || command === 'stats') { const largeDeps = analyzer.findLargeDependencies(analysis.packageInfo) const issues = analyzer.findPotentialIssues(analysis.packageInfo) const recommendations = analyzer.generateRecommendations(analysis.stats, issues) return { type: 'jsx', render: () => [ '📊 依赖分析概览', '', `项目: ${analysis.packageInfo.name || '未命名'}@${analysis.packageInfo.version || '未知版本'}`, `目录: ${cwd}`, '', '📈 统计信息:', ` 总依赖: ${analysis.stats.total}`, ` 生产依赖: ${analysis.stats.production}`, ` 开发依赖: ${analysis.stats.development}`, '', '🏗️ 大型依赖:', ...(largeDeps.length > 0 ? largeDeps.map(dep => ` • ${dep.name}@${dep.version} (${dep.type})`) : [' 未发现特别大型的依赖']), '', '⚠️ 潜在问题:', ...(issues.length > 0 ? issues.map(issue => ` • ${issue}`) : [' 未发现明显问题']), '', '💡 优化建议:', ...recommendations.map(rec => ` • ${rec}`), '', '🔍 详细分析:', ' 使用 large 命令查看大型依赖详情', ' 使用 issues 命令查看具体问题' ].join('/n') } } if (command === 'large') { const largeDeps = analyzer.findLargeDependencies(analysis.packageInfo) if (largeDeps.length === 0) { return { type: 'jsx', render: () => [ '✅ 大型依赖分析', '', '未发现特别大型的依赖包。', '', '💡 提示:', ' 大型依赖通常指:', ' • 功能丰富的框架（React、Vue等）', ' • 构建工具（Webpack、Babel等）', ' • 测试工具（Jest、Cypress等）', ' • 工具库（Lodash、Moment等）', '', '保持建议:', ' • 定期评估依赖的必要性', ' • 考虑使用轻量级替代方案', ' • 注意依赖的更新和维护状态' ].join('/n') } } const prodLarge = largeDeps.filter(d => d.type === 'production') const devLarge = largeDeps.filter(d => d.type === 'development') return { type: 'jsx', render: () => [ '🏗️ 大型依赖分析', '', `发现 ${largeDeps.length} 个大型依赖:`, '', prodLarge.length > 0 ? '生产环境大型依赖:' : '', ...prodLarge.map(dep => ` • ${dep.name}@${dep.version}`), '', devLarge.length > 0 ? '开发环境大型依赖:' : '', ...devLarge.map(dep => ` • ${dep.name}@${dep.version}`), '', '📊 影响分析:', ' 大型依赖可能带来以下影响:', ' • 增加打包体积', ' • 延长构建时间', ' • 增加内存使用', ' • 可能引入安全漏洞', '', '🔧 优化建议:', ' 1. 评估是否真的需要这些依赖', ' 2. 考虑使用轻量级替代品', ' 3. 使用按需加载（tree-shaking）', ' 4. 定期更新到最新版本', ' 5. 监控依赖的维护状态' ].join('/n') } } if (command === 'issues') { const issues = analyzer.findPotentialIssues(analysis.packageInfo) if (issues.length === 0) { return { type: 'jsx', render: () => [ '✅ 依赖问题检查', '', '未发现明显的依赖问题。', '', '💡 良好实践:', ' • 使用稳定的版本范围', '
