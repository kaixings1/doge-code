{
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash D:/doge-code/.claude/hooks/secret-blocker.sh"
          },
          {
            "type": "command",
            "command": "bash D:/doge-code/.claude/hooks/protected-files.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash D:/doge-code/.claude/hooks/sensitive-data-blocker.sh"
          }
        ]
      },
      {
        "matcher": "mcp__mongodb|mcp__mssql|mcp__postgres",
        "hooks": [
          {
            "type": "command",
            "command": "bash D:/doge-code/.claude/hooks/sensitive-data-mcp-blocker.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash D:/doge-code/.claude/hooks/auto-format.sh"
          },
          {
            "type": "command",
            "command": "bash D:/doge-code/.claude/hooks/test-on-change.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash D:/doge-code/.claude/hooks/sensitive-data-output-blocker.sh"
          }
        ]
      },
      {
        "matcher": "mcp__mongodb|mcp__mssql|mcp__postgres",
        "hooks": [
          {
            "type": "command",
            "command": "bash D:/doge-code/.claude/hooks/sensitive-data-output-blocker.sh"
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash D:/doge-code/.claude/hooks/sensitive-data-output-blocker.sh"
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash D:/doge-code/.claude/hooks/auto-executor.sh",
            "timeout": 10000,
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash D:/doge-code/.claude/hooks/auto-executor.sh",
            "timeout": 10000,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash D:/doge-code/.claude/hooks/uat-reminder.sh"
          },
          {
            "type": "command",
            "command": "bash D:/doge-code/.claude/hooks/self-improve.sh"
          },
          {
            "type": "command",
            "command": "node D:/doge-code/.claude/hooks/heartflow-guard.ts",
            "timeout": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node D:/doge-code/.claude/hooks/heartflow-guard.ts",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "node D:/doge-code/.claude/hooks/skill-activation-prompt.ts \"$ARGUMENTS\"",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
