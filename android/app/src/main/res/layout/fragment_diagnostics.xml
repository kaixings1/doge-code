<?xml version="1.0" encoding="utf-8"?>
<!--
  连接诊断页（原为 AlertDialog）。

  弹窗装不下这些内容 —— 之前挤在一个 message 字符串里，
  字号小、不能滚动选段、不能复制。改独立页后可分区展示。

  分区：当前状态 / 最近失败 / 常见原因对照 / 可执行动作
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/SettingsSection"
            android:layout_marginTop="0dp"
            android:text="@string/diag_section_status" />

        <!-- 当前状态：值由代码填充，等宽便于对齐 -->
        <TextView
            android:id="@+id/diag_status"
            style="@style/DiagBlock" />

        <TextView
            style="@style/SettingsSection"
            android:text="@string/diag_section_last_failure" />

        <TextView
            android:id="@+id/diag_failure"
            style="@style/DiagBlock" />

        <TextView
            style="@style/SettingsSection"
            android:text="@string/diag_section_common_causes" />

        <TextView
            android:id="@+id/diag_causes"
            style="@style/DiagBlock" />

        <TextView
            style="@style/SettingsSection"
            android:text="@string/diag_section_history" />

        <TextView
            android:id="@+id/diag_history_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:textColor="#888888"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/diag_history"
            style="@style/DiagBlock" />

        <Button
            android:id="@+id/diag_clear_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/diag_clear_history" />

        <TextView
            style="@style/SettingsSection"
            android:text="@string/diag_section_actions" />

        <Button
            android:id="@+id/diag_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/diag_retry" />

        <Button
            android:id="@+id/diag_use_usb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/diag_use_usb" />

        <Button
            android:id="@+id/diag_copy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/diag_copy_report" />

        <Button
            android:id="@+id/diag_clear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/diag_clear_failure" />
    </LinearLayout>
</ScrollView>
