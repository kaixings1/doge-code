<?xml version="1.0" encoding="utf-8"?>
<!--
  对话页的搜索栏（默认隐藏，点顶栏放大镜展开）。

  设计成独立的可隐藏条而非持久占用一行：搜索是**偶尔**的操作，
  常驻会挤占本就有限的竖向空间（手机屏幕是稀缺资源）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#202020"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:visibility="gone">

    <EditText
        android:id="@+id/search_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="#2D2D2D"
        android:hint="@string/chat_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="#E8E8E8"
        android:textColorHint="#777777"
        android:textSize="13sp" />

    <!-- 命中计数：让用户知道「有没有搜到」以及在第几个 -->
    <TextView
        android:id="@+id/search_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:minWidth="48dp"
        android:gravity="center"
        android:textColor="#8AB4F8"
        android:textSize="12sp" />

    <ImageButton
        android:id="@+id/search_prev"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/search_prev"
        android:src="@android:drawable/ic_media_previous" />

    <ImageButton
        android:id="@+id/search_next"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/search_next"
        android:src="@android:drawable/ic_media_next" />

    <ImageButton
        android:id="@+id/search_close"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/search_close"
        android:src="@android:drawable/ic_menu_close_clear_cancel" />
</LinearLayout>
