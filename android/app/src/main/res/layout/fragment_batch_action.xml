<?xml version="1.0" encoding="utf-8"?>
<!--
  批量选择操作栏：横向条，含「全选 / 复制所选(N) / 删除所选(N) / 取消」。
  仅在选择模式时显示（父布局控制 visibility）。
  按钮文字随选中数变化（如「复制所选(3)」）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#2A2A2A"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/batch_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textColor="#CCCCCC"
        android:textSize="13sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/batch_select_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/batch_select_all"
        android:textColor="#EAF2FF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/batch_copy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/batch_copy"
        android:textColor="#EAF2FF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/batch_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/batch_delete"
        android:textColor="#EF5350"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/batch_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/batch_cancel"
        android:textColor="#BBBBBB"
        android:textSize="13sp" />
</LinearLayout>
