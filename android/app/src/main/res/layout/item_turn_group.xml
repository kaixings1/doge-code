<?xml version="1.0" encoding="utf-8"?>
<!--
  回合分组的组头：「本轮活动（12 项）」+ 折叠箭头。

  为什么用一个独立行而非把组头塞进某条气泡里：组头是一条**独立信息**
  （「这轮跑了多少步」），挂在某条气泡上会让它的显隐与那条气泡绑定，
  而组内成员是动态增减的（工具还在跑）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/group_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/group_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_group"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/group_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▸"
            android:textColor="#8AB4F8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/group_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#9AA4B2"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>