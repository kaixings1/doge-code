<?xml version="1.0" encoding="utf-8"?>
<!--
  设置项：多选一型（点行 → 展开选项条）。

  与 item_pref_toggle 分开而非合一：开关是「两态、直接切」，
  多选一是「多态、需展开」。合一会让两种交互挤在一个布局里，
  且 Switch 与选项条不能同时显示 —— 强制复用反而更难读。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/pref_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pref_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#DDDDDD"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pref_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxWidth="160dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#8AB4F8"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/pref_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#777777"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 选项条：横向滚动，避免选项多时换行挤乱布局 -->
    <HorizontalScrollView
        android:id="@+id/pref_options_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/pref_options"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="10dp" />
    </HorizontalScrollView>
</LinearLayout>
