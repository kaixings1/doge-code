<?xml version="1.0" encoding="utf-8"?>
<!--
  工具气泡：一行可折叠的标题 +（展开时）命令原文 + 结果。

  与普通消息气泡不同：它是**过程性活动**而非对话内容，折叠时只占一行，
  避免「一次重构几十条工具调用」把正文淹没。点击标题行切换折叠。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tool_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <!-- 标题行：折叠箭头 + 摘要 + 状态。整行可点击折叠。 -->
    <LinearLayout
        android:id="@+id/tool_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_tool"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tool_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▸"
            android:textColor="#8AB4F8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tool_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#D8D8D8"
            android:textSize="13sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/tool_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#888888"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 展开体：命令原文 + 结果。折叠时 GONE，点击标题行切换。 -->
    <LinearLayout
        android:id="@+id/tool_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="2dp"
        android:background="#1E1E1E"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tool_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B8C7E0"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:typeface="monospace"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tool_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#9CA3AF"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:typeface="monospace"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tool_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#666666"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>