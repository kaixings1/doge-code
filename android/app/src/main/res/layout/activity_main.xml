<?xml version="1.0" encoding="utf-8"?>
<!--
  主容器：顶部状态栏 + 内容区（三个 Fragment 切换）+ 底部导航。

  为什么改成容器而不是继续堆内容：
  此前 MainActivity 是「一个聊天列表 + 一个藏在齿轮里的连接面板」，
  其余功能（会话列表/诊断/配置/重命名/导出）全是 AlertDialog。
  1280 行的一个类 + 9 个弹窗 —— 这不是「功能少」，是**架构撑不住**，
  每个新功能只能退化成一个弹窗。

  底部导航用 LinearLayout 手写而非 BottomNavigationView：
  · 只有 3 个固定 tab，不需要 Material 库的 badging/动画/标签行为配置
  · 不引入新依赖（本工程依赖很精简，见 build.gradle.kts 的注释）
  · 完全可控 —— 深色主题下 Material 的默认配色要额外覆盖一堆属性
  按 YAGNI 阶梯：原生平台特性优先于引入依赖。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A"
    android:orientation="vertical">

    <!--
      顶部状态栏：全局共享（三个 tab 都要看连接状态，不能让用户切到聊天页
      才知道断线了）。点击进设置页的诊断区。
    -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#232323"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <View
            android:id="@+id/dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_off" />

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/status_idle"
            android:textColor="#CCCCCC"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btn_chat_search"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_search_toggle"
            android:src="@android:drawable/ic_menu_search" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="true"
        android:max="100"
        android:visibility="gone" />

    <!-- 内容区：三个 Fragment 在这里切换（show/hide，不重建） -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!--
      底部导航。用 weight 三等分，选中态用颜色 + 加粗区分。

      图标用系统内置的（android.R.drawable），不为三个 tab 引入矢量图资源 ——
      本工程此前连 launcher icon 都是复用的系统资源。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#232323"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tab_sessions"
            style="@style/BottomTab"
            android:text="@string/tab_sessions" />

        <TextView
            android:id="@+id/tab_chat"
            style="@style/BottomTab"
            android:text="@string/tab_chat" />

        <TextView
            android:id="@+id/tab_settings"
            style="@style/BottomTab"
            android:text="@string/tab_settings" />
    </LinearLayout>
</LinearLayout>
