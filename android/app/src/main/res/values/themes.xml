<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DogeMobile" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#1a1a1a</item>
        <item name="android:statusBarColor">#232323</item>
    </style>

    <!--
      底部导航项。三等分，点击区 48dp（低于 44dp 手指点不准）。

      用 TextView 而非 BottomNavigationView：只有 3 个固定 tab，
      不需要 Material 的 badging/动画/标签行为配置；且深色主题下
      Material 默认配色要覆盖一堆属性，反而更麻烦。
      按 YAGNI 阶梯：原生控件优先于引入依赖。

      选中态由代码切换 textColor（见 MainActivity.selectTab）——
      XML 无法表达「三选一」的互斥状态。
    -->
    <!-- 设置页的分组标题：与下面的控件拉开距离，形成视觉分组 -->
    <style name="SettingsSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">#8AB4F8</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 设置行：左标签 + 右值 + 可点击 -->
    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="SettingsRowLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#DDDDDD</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SettingsRowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxWidth">200dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#8AB4F8</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!--
      内联选项（Chip 式）。选中态由代码设背景色。
      用 TextView 而非 Material 的 Chip：只有三项、每项几个选项，
      不值得为此引入 Material 组件依赖。
    -->
    <style name="OptionChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#CCCCCC</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!--
      信息块：等宽字体 + 深底 + 内边距。用于诊断/关于/详情页展示成段信息。
      等宽是为了让「键：值」这类内容对齐易读。
    -->
    <style name="DiagBlock">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">#222222</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">#CCCCCC</item>
        <item name="android:textSize">12sp</item>
        <item name="android:typeface">monospace</item>
        <item name="android:textIsSelectable">true</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="BottomTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#888888</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>
    <!--
      浅色主题。

      **已知局限**：现有布局与 Adapter 里大量颜色是硬编码的
      （#1A1A1A / #E8E8E8 等），不会随主题变化。故本主题目前只影响
      窗口背景、状态栏，以及 AppCompat 控件的默认底色。

      完整浅色化需要把硬编码颜色抽到 colors.xml 再用主题属性引用 ——
      属较大改动，暂未做。设置项里已就此给出说明。
    -->
    <style name="Theme.DogeMobile.Light" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">#F5F5F5</item>
        <item name="android:statusBarColor">#E0E0E0</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 跟随系统：浅色系统下用浅色主题（通过 -night 资源限定符实现） -->
</resources>
