<?xml version="1.0" encoding="utf-8"?>
<!--
  对话页（横屏 / landscape）。

  与竖屏同结构，仅布局不同：横屏宽，把「工具活动区」从底部移到底部
  输入栏之上的右侧窄列，与消息列表并排 —— 这样长代码块在左侧主列
  能横向铺开，工具活动的滚动过程也不挤压对话。

  view id 全部与竖屏一致，ChatFragment 代码无需改动。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A"
    android:orientation="vertical">

    <!-- 搜索栏：与竖屏一致，默认隐藏 -->
    <include
        android:id="@+id/chat_search_bar"
        layout="@layout/fragment_chat_search" />

    <!-- 主体：消息列表（主列）+ 工具活动区（右侧窄列）并排 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 消息列表 + 滚动到底 / 未读提示 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:scrollbars="vertical" />

            <ImageButton
                android:id="@+id/btn_scroll_bottom"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/chip_bg"
                android:contentDescription="@string/scroll_to_bottom"
                android:src="@android:drawable/ic_media_ff"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_unseen"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bubble_user"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#EAF2FF"
                android:textSize="12sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 工具活动区：横屏移到右侧窄列，不挤占对话 -->
        <LinearLayout
            android:id="@+id/activity_panel"
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/activity_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textColor="#8AB4F8"
                    android:textSize="12sp"
                    android:typeface="monospace" />

                <ImageButton
                    android:id="@+id/activity_stop"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/terminate_agent"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 输入栏：与竖屏一致，底部全宽 -->
    <LinearLayout
        android:id="@+id/input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#232323"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/msg_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/input_bg"
            android:hint="@string/msg_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="5"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="#E8E8E8"
            android:textColorHint="#777777"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btn_voice"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/voice_input"
            android:src="@android:drawable/ic_btn_speak_now" />

        <ImageButton
            android:id="@+id/btn_more"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more_actions"
            android:src="@android:drawable/ic_menu_add" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/send"
            android:src="@android:drawable/ic_menu_send" />

        <ImageButton
            android:id="@+id/btn_stop"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/interrupt"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
