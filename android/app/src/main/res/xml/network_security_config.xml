<?xml version="1.0" encoding="utf-8"?>
<!--
  允许明文 HTTP/WS 流量，仅用于 App 内 WebView 加载对话页面。
  原生客户端（BridgeClient 的 OkHttp WebSocket、SessionScanner 的
  HttpURLConnection）不走本配置，由 manifest 的 usesCleartextTraffic="true" 覆盖。

  Android 的 <domain> 只接受具体主机名/IP，不支持 CIDR 网段，因此这里只能
  逐个列举。若你的电脑局域网 IP 不在下方列表（如 192.168.1.x / 10.x），
  用手机浏览器扫码打开页面时会被系统拦截（表现为 ERR_CLEARTEXT_NOT_PERMITTED）；
  此时把该 IP 加进来即可。原生 App 连接不受此限制。

  不使用全局 cleartextTrafficPermitted=true，避免对任意公网地址也放开明文。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- 本机当前 WLAN 地址；换网段时按上方说明补充 -->
        <domain includeSubdomains="true">192.168.0.106</domain>
    </domain-config>
</network-security-config>
