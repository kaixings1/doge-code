<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 助手回复通知（Android 13+ 需运行时授权，拒绝不影响主流程） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.DogeMobile"
        android:usesCleartextTraffic="true">
        <!--
          明文流量放行有两个层面，缺一不可：
          - usesCleartextTraffic：应用级开关
          - networkSecurityConfig：域名级白名单（WebView 在 targetSdk 28+
            主要看后者，只设前者可能仍被拦）
          桥接是明文 ws:// / http://（无 TLS），安全前提是仅在可信局域网使用
          （见 docs/mobile-verify.md 安全说明）。
        -->

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
